APP_NAME=CryptoPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Postgres in docker-compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cryptopay
DB_USERNAME=cryptopay
DB_PASSWORD=secret

# --- Redis / queue / cache / session ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- CryptoPay ---
# Shared secret between backend and watcher (X-Internal-Token). CHANGE IN PROD.
INTERNAL_API_TOKEN=change-me-internal-token
# Watcher base URL inside the compose network.
WATCHER_URL=http://watcher:3100
WATCHER_TIMEOUT=10
# Allows POST /api/admin/invoices/{id}/simulate-payment. Turn OFF in production.
SIMULATION_ENABLED=true

# Bootstrap admin account (seeded once; changing it later does not reset the password).
ADMIN_EMAIL=admin@cryptopay.local
ADMIN_PASSWORD=password

# Deterministic demo merchant key in local/testing: cp_live_ + 40 hex chars.
DEMO_API_KEY=cp_live_ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@cryptopay.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
