{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Caddy сам выставляет X-Forwarded-For / X-Forwarded-Proto.
	reverse_proxy nginx:80
}

# Сайты соседних проектов (docker/caddy/sites/*.caddy, в git не хранятся). Нет файлов — не ошибка.
import /etc/caddy/sites/*.caddy
