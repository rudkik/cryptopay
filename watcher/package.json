{
  "name": "cryptopay-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "CryptoPay watcher: HD address derivation + EVM/Tron USDT/USDC deposit scanning",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "keygen": "node dist/keygen.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "keygen:dev": "tsx src/keygen.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "fastify": "^5.2.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
