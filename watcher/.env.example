# ---- Окружение ----
# Управляет строгостью проверки секретов. Всё, кроме local/dev/test, считается
# боевым: с пустым или плейсхолдерным INTERNAL_API_TOKEN процесс НЕ стартует.
# Именно APP_ENV, а не NODE_ENV: NODE_ENV=production зашит в Dockerfile ради
# `npm ci --omit=dev` и признаком боевого стенда не является.
APP_ENV=local

# ---- Связь с backend (внутри docker compose) ----
# Внутренний порт nginx: /api/internal на публичном :80 отдаёт 404, чтобы
# внутреннее API нельзя было дёрнуть снаружи (порт 8081 не публикуется).
BACKEND_URL=http://nginx:8081
# Общий секрет с backend. Сгенерировать: `openssl rand -hex 32`.
# Пустое/`change-me…` значение = отказ старта вне local (см. APP_ENV выше).
INTERNAL_API_TOKEN=change-me-internal-token

# ---- HTTP-сервер watcher ----
PORT=3100

# ---- RPC / API сетей ----
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io
# необязателен; если задан, уходит заголовком TRON-PRO-API-KEY
TRON_API_KEY=

# ---- Деривация (npm run keygen), приватных ключей сервис не хранит ----
#
# Переменной MNEMONIC у сервиса НЕТ и не должно появиться: мнемоника нужна
# только офлайновому `npm run keygen`, который печатает её в stdout и принимает
# готовую фразу лишь аргументом CLI (`--mnemonic "..."`). Рантайм оперирует
# исключительно xpub, поэтому украсть приватные ключи из контейнера нечем.
#
# Утечка xpub НЕ ведёт к потере средств (приватные ключи из него не выводятся),
# но раскрывает все депозитные адреса и весь оборот — это потеря приватности,
# поэтому xpub хранится и обрабатывается как секрет: не в логах, не в /health.
EVM_XPUB=
TRON_XPUB=

# ---- Поведение ----
# false = только деривация и /health, без сканирования сетей
WATCHER_ENABLED=true
DATA_DIR=./data
LOG_LEVEL=info
EVM_BATCH_BLOCKS=20
POLL_INTERVAL_MS=5000

# ---- Необязательный тюнинг (значения по умолчанию) ----
# HOST=0.0.0.0  (порт 3100 наружу не публикуется, только docker-сеть)
# CONFIG_REFRESH_MS=60000
# ADDRESS_REFRESH_MS=10000
# HEARTBEAT_MS=15000
# REORG_DEPTH=64
# MAX_LAG_BLOCKS=50
# MAX_CONSECUTIVE_ERRORS=3
# BACKEND_RETRIES=5
# REQUEST_TIMEOUT_MS=30000
