# =============================================================================
# CryptoPay — единый .env для docker compose.
#
#   cp .env.example .env  &&  make check-env
#
# Значения ниже — ПЛЕЙСХОЛДЕРЫ для локального стенда. Все они публичны (лежат в
# git), поэтому вне APP_ENV=local каждый из них обязан быть заменён:
#   DB_PASSWORD, REDIS_PASSWORD, ADMIN_PASSWORD, INTERNAL_API_TOKEN, APP_KEY.
# `make check-env` падает, если что-то из этого осталось дефолтным при
# APP_ENV != local.
# =============================================================================

# ---------- App ----------
APP_NAME=CryptoPay
# APP_ENV управляет строгостью проверок секретов и в backend, и в watcher.
# Всё, кроме local/dev/test, считается боевым окружением.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8095
APP_KEY=
APP_PORT=8095
# Режим TLS (docker compose --profile tls up -d): домен и e-mail для Let's Encrypt,
# nginx при этом слушает только localhost (APP_BIND=127.0.0.1), снаружи — caddy :80/:443.
#DOMAIN=pay.example.com
#ACME_EMAIL=admin@example.com
#APP_BIND=127.0.0.1
# Разрешает кнопку "Simulate payment" в админке: создаёт транзакцию в обход
# блокчейна тем же pipeline, что и watcher. В docker-compose по умолчанию FALSE;
# true имеет смысл только на локальном/демо-стенде.
SIMULATION_ENABLED=true
# Модуль token sale (продажа токенов за USDT/USDC): маршруты /tokens,
# /token-purchases, /customers/{id}/holdings и их админские двойники. По
# умолчанию ВЫКЛЮЧЕН — при false эти пути отвечают 404, приём платежей не
# затрагивается.
TOKEN_SALE_ENABLED=false

# ---------- Database / cache ----------
DB_DATABASE=cryptopay
DB_USERNAME=cryptopay
# ПЛЕЙСХОЛДЕР. Заменить: `openssl rand -hex 24`
DB_PASSWORD=secret
# Пустое значение = redis без пароля (годится, только пока порт 6379 не покидает
# docker-сеть). Вне local задайте: `openssl rand -hex 24`
# Значение прокидывается и в redis (--requirepass), и в backend (REDIS_PASSWORD).
REDIS_PASSWORD=

# ---------- Admin (создаётся сидером) ----------
ADMIN_EMAIL=admin@cryptopay.local
# ПЛЕЙСХОЛДЕР: пароль первого админа. Обязательно заменить вне local.
ADMIN_PASSWORD=password

# ---------- Internal auth (backend <-> watcher) ----------
# ОБЯЗАТЕЛЬНО заменить вне local: с placeholder-значением /api/internal/* отдаёт 503,
# а watcher вообще отказывается стартовать. Сгенерировать: `openssl rand -hex 32`
INTERNAL_API_TOKEN=change-me-internal-token-please

# ---------- Webhooks / сессии ----------
# только для локального демо: разрешает вебхуки на приватные адреса/имена compose.
# В docker-compose значение по умолчанию false — это защита от SSRF, когда
# мерчант указывает webhook_url вида http://app:9000/... или http://169.254.169.254/.
WEBHOOK_ALLOW_PRIVATE=true
# Таймаут одной попытки доставки вебхука, секунды. Значение зажимается в
# диапазон 1…10 (config/services.php): медленный приёмник не должен держать
# воркер очереди.
WEBHOOK_TIMEOUT=10
# Время жизни токена админки в минутах (12ч).
SANCTUM_EXPIRATION=720

# ---------- Blockchain ----------
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io
# Рекомендуется: бесплатный ключ на trongrid.io, без него строгий rate limit.
# Ключ считается секретом и вырезается из логов и /health.
TRON_API_KEY=
# Получить: `make keys` (или `cd watcher && npm run keygen`).
#
# МНЕМОНИКА В .env НЕ ХРАНИТСЯ И РАНТАЙМОМ НЕ ЧИТАЕТСЯ. Переменной MNEMONIC у
# сервисов нет: `npm run keygen` печатает фразу в stdout один раз, дальше её
# место — офлайн-хранилище. Приватных ключей в системе не появляется, вывод
# средств делается вручную вне CryptoPay (SPEC: withdrawals не реализуются).
#
# Утечка xpub НЕ даёт доступа к средствам: из него нельзя получить приватные
# ключи, только публичные адреса. Но это полная деанонимизация — по xpub видно
# ВСЕ депозитные адреса мерчанта и весь их оборот в блокчейне. Поэтому xpub
# считается секретом наравне с паролями: не коммитить, не отдавать в /health,
# не логировать.
EVM_XPUB=
TRON_XPUB=
# false = watcher только выдаёт адреса, сети не сканирует
WATCHER_ENABLED=true
EVM_BATCH_BLOCKS=20
POLL_INTERVAL_MS=5000            # потолок интервала опроса; по сетям: bsc 1500, tron 3000, ethereum 5000 (POLL_INTERVAL_MS_BSC и т.д. переопределяют)
LOG_LEVEL=info
