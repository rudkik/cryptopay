
# ---------- App ----------
APP_NAME=CryptoPay
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8095
APP_KEY=
APP_PORT=8095
# Разрешает кнопку "Simulate payment" в админке (выключить в проде!)
SIMULATION_ENABLED=true

# ---------- Database / cache ----------
DB_DATABASE=cryptopay
DB_USERNAME=cryptopay
DB_PASSWORD=secret

# ---------- Admin (создаётся сидером) ----------
ADMIN_EMAIL=admin@cryptopay.local
ADMIN_PASSWORD=password

# ---------- Internal auth (backend <-> watcher) ----------
INTERNAL_API_TOKEN=change-me-internal-token-please

# ---------- Blockchain ----------
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=                   # рекомендуется: бесплатный ключ на trongrid.io, без него строгий rate limit
# Получить: `make keys` (или `cd watcher && npm run keygen`)
EVM_XPUB=
TRON_XPUB=
# false = watcher только выдаёт адреса, сети не сканирует
WATCHER_ENABLED=true
EVM_BATCH_BLOCKS=20
POLL_INTERVAL_MS=5000
LOG_LEVEL=info
